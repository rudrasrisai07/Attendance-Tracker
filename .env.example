# ==========================================================
# Attendance Tracker 2.0 - Environment Configuration Template
# Copy this file to .env and configure your local settings.
# DO NOT commit real secrets to version control.
# ==========================================================

PORT=5000
NODE_ENV=development

# PostgreSQL Connection URL
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/attendance_tracker

# JWT Authentication Secret
JWT_SECRET=YOUR_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# Initial Administrator Credentials (used by npm run seed:admin)
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@attendance.local
ADMIN_PASSWORD=AdminSecurePassword123!

# Application URL (used for password reset links)
APP_URL=http://localhost:5000

# Email Delivery Configuration (Nodemailer)
# Keep EMAIL_ENABLED=false for local development:
# reset URLs will print directly to your server terminal!
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=


